---
import {sanityClient} from 'sanity:client'
import {defineQuery} from 'groq'

const DEMO_QUERY = defineQuery(`{
  "settings": *[_id == "siteSettings"][0]{schoolName, tagline, phone, email, address, trialUrl},
  "home": *[_id == "homePage"][0]{title, description, heroHeading, heroText, aboutHeading, aboutText},
  "programs": *[_type == "program"] | order(sortOrder asc){name, ageRange, summary, slug}
}`)

const content = await sanityClient.fetch(DEMO_QUERY)
const settings = content?.settings
const home = content?.home
const programs = content?.programs ?? []

const title = home?.title ?? settings?.schoolName ?? 'Summit ATA Martial Arts'
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={home?.description ?? 'Martial arts in Morristown, Tennessee'} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">{settings?.schoolName ?? 'Summit ATA Martial Arts'}</a>
      <a class="trial-link" href={settings?.trialUrl ?? '#programs'}>Start a trial</a>
    </header>

    <main>
      <section class="hero">
        <p class="kicker">Morristown, Tennessee</p>
        <h1>{home?.heroHeading ?? 'Build confidence. Learn discipline.'}</h1>
        <p>{home?.heroText}</p>
      </section>

      <section class="programs" id="programs">
        <p class="kicker">Programs</p>
        <h2>Find the right training for you</h2>
        <div class="program-grid">
          {programs.map((program) => (
            <article>
              <p class="age-range">{program.ageRange}</p>
              <h3>{program.name}</h3>
              <p>{program.summary}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="about">
        <p class="kicker">About Summit ATA</p>
        <h2>{home?.aboutHeading}</h2>
        <p>{home?.aboutText}</p>
      </section>
    </main>

    <footer>
      <strong>{settings?.schoolName}</strong>
      <span>{settings?.address}</span>
      <span>{settings?.phone}</span>
      <span>{settings?.email}</span>
    </footer>
  </body>
</html>

<style>
  :root {
    --ink: #171717;
    --paper: #f7f5ef;
    --red: #c51f2f;
    --blue: #164b7a;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    color: var(--ink);
    background: var(--paper);
    font-family: Georgia, 'Times New Roman', serif;
  }

  header, main, footer { width: min(1120px, calc(100% - 32px)); margin-inline: auto; }

  header {
    height: 76px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #d7d2c7;
  }

  .brand { color: var(--ink); text-decoration: none; font-size: 1.1rem; font-weight: 700; }

  .trial-link {
    color: white;
    background: var(--red);
    padding: 12px 16px;
    text-decoration: none;
  }

  .hero { padding: 88px 0 96px; max-width: 820px; }
  .kicker { color: var(--blue); font-family: Arial, sans-serif; font-size: 0.78rem; font-weight: 700; text-transform: uppercase; }
  h1, h2, h3 { margin: 0; letter-spacing: 0; }
  h1 { max-width: 780px; font-size: clamp(3rem, 8vw, 6.5rem); line-height: 0.95; }
  .hero > p:last-child { max-width: 590px; font-size: 1.25rem; line-height: 1.55; }

  .programs { border-top: 5px solid var(--blue); padding: 48px 0 88px; }
  h2 { margin: 10px 0 28px; font-size: clamp(2.1rem, 5vw, 4.2rem); line-height: 1; }
  .program-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  article { min-height: 260px; border: 1px solid #d7d2c7; padding: 22px; background: white; }
  .age-range { color: var(--red); font-family: Arial, sans-serif; font-size: 0.78rem; font-weight: 700; }
  h3 { font-size: 1.6rem; }
  article p:last-child { line-height: 1.55; }

  .about { border-top: 1px solid #d7d2c7; padding: 72px 0 88px; max-width: 820px; }
  .about > p:last-child { font-size: 1.25rem; line-height: 1.7; }

  footer { border-top: 1px solid #d7d2c7; padding: 32px 0 48px; display: grid; gap: 6px; }

  @media (max-width: 800px) {
    .hero { padding: 64px 0 72px; }
    .program-grid { grid-template-columns: 1fr 1fr; }
  }

  @media (max-width: 520px) {
    header { height: 68px; }
    .brand { max-width: 190px; }
    .trial-link { padding: 10px 12px; }
    .program-grid { grid-template-columns: 1fr; }
  }
</style>
